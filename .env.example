# Garmin Personal API key (required for Garmin sync). Never commit the real .env.
GARMIN_API_KEY=

# Optional: date the key expires (YYYY-MM-DD). The app warns 14 days before.
# Can also be set in the app under Settings.
GARMIN_API_KEY_EXPIRES=

# Optional overrides
# DATABASE_PATH=data/readiness.db
# HOST=127.0.0.1          # keep on localhost; expose only through `tailscale serve`
# PORT=8000
# SYNC_INTERVAL_MINUTES=60
# GARMIN_HISTORY_DAYS=365
